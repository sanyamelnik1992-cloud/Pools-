# Скопируйте в .env (cp .env.example .env) и впишите свои значения. Файл .env в git не попадает.
# Боевой режим (python3 bot.py live) читает его сам; на сервере можно указать другой файл: --env /путь/к/файлу.
# Права на .env бот сам сужает до 600 (читает только владелец).
export SUI_PRIVATE_KEY="suiprivkey1..."   # ключ ОТДЕЛЬНОГО кошелька бота (Slush → экспорт приватного ключа)
export TG_TOKEN="123456789:AA..."         # токен от @BotFather
export TG_CHAT="123456789"                # id вашего чата с ботом (getUpdates)
